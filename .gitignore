node_modules/
dist/
dev-dist/
.DS_Store
*.local
.vite/

# Capacitor / Android: build artifacts are handled by android/.gitignore.
# Keep these as a safety net for files generated outside that folder.
*.apk
*.aab
*.keystore

# Asset-generation inputs: keep the README, ignore the actual photos / refs.
assets-src/burhan-photos/*
!assets-src/burhan-photos/README.md
assets-src/sprite-sheet/*
!assets-src/sprite-sheet/README.md

# Python tooling
__pycache__/
*.pyc
